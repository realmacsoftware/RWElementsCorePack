{
  "groups": [
    {
      "title": "Mask",
      "icon": "theatermask.and.paintbrush",
      "properties": [
        {
          "title": "Type",
          "id": "maskType",
          "responsive": false,
          "select": {
            "default": "none",
            "items": [
              {
                "title": "None",
                "value": "none"
              },
              {
                "title": "SVG",
                "value": "svg"
              },
              {
                "title": "Edge",
                "value": "edge"
              },
              {
                "title": "Linear",
                "value": "linear"
              },
              {
                "title": "Radial",
                "value": "radial"
              }
            ]
          }
        },
        {
          "visible": "maskType == 'svg'",
          "title": "SVG",
          "id": "maskResource",
          "resource": {
            "types": [
              "svg"
            ]
          }
        },
        {
          "visible": "maskType == 'svg'",
          "title": "Mode",
          "id": "maskMode",
          "select": {
            "default": "mask-alpha",
            "items": [
              {
                "title": "Alpha",
                "value": "mask-alpha"
              },
              {
                "title": "Luminance",
                "value": "mask-luminance"
              }
            ]
          }
        },
        {
          "visible": "maskType == 'svg'",
          "title": "Size",
          "id": "maskSize",
          "select": {
            "default": "mask-contain",
            "items": [
              {
                "title": "Auto",
                "value": "mask-auto"
              },
              {
                "title": "Contain",
                "value": "mask-contain"
              },
              {
                "title": "Cover",
                "value": "mask-cover"
              },
              {
                "title": "Custom",
                "value": "custom"
              }
            ]
          }
        },
        {
          "visible": "maskType == 'svg' && maskSize == 'custom'",
          "title": "Custom Size",
          "id": "maskCustomSize",
          "text": {
            "default": "100%_100%",
            "subtitle": "Use a Tailwind arbitrary value such as 100%_100% or auto_120px."
          }
        },
        {
          "visible": "maskType == 'svg'",
          "title": "Position",
          "id": "maskPosition",
          "select": {
            "default": "mask-center",
            "items": [
              {
                "title": "Top Left",
                "value": "mask-top-left"
              },
              {
                "title": "Top",
                "value": "mask-top"
              },
              {
                "title": "Top Right",
                "value": "mask-top-right"
              },
              {
                "title": "Left",
                "value": "mask-left"
              },
              {
                "title": "Center",
                "value": "mask-center"
              },
              {
                "title": "Right",
                "value": "mask-right"
              },
              {
                "title": "Bottom Left",
                "value": "mask-bottom-left"
              },
              {
                "title": "Bottom",
                "value": "mask-bottom"
              },
              {
                "title": "Bottom Right",
                "value": "mask-bottom-right"
              }
            ]
          }
        },
        {
          "visible": "maskType == 'svg'",
          "title": "Repeat",
          "id": "maskRepeat",
          "select": {
            "default": "mask-no-repeat",
            "items": [
              {
                "title": "No Repeat",
                "value": "mask-no-repeat"
              },
              {
                "title": "Repeat",
                "value": "mask-repeat"
              },
              {
                "title": "Horizontal",
                "value": "mask-repeat-x"
              },
              {
                "title": "Vertical",
                "value": "mask-repeat-y"
              },
              {
                "title": "Round",
                "value": "mask-repeat-round"
              },
              {
                "title": "Space",
                "value": "mask-repeat-space"
              }
            ]
          }
        },
        {
          "visible": "maskType == 'svg'",
          "information": {},
          "title": "Opaque areas of the SVG reveal the wrapped content."
        },
        {
          "visible": "maskType == 'edge'",
          "title": "Side",
          "id": "maskEdgeSide",
          "select": {
            "default": "b",
            "items": [
              {
                "title": "Top",
                "value": "t"
              },
              {
                "title": "Right",
                "value": "r"
              },
              {
                "title": "Bottom",
                "value": "b"
              },
              {
                "title": "Left",
                "value": "l"
              },
              {
                "title": "Horizontal",
                "value": "x"
              },
              {
                "title": "Vertical",
                "value": "y"
              }
            ]
          }
        },
        {
          "visible": "maskType == 'edge'",
          "title": "From",
          "id": "maskEdgeFrom",
          "slider": {
            "default": 75,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "visible": "maskType == 'edge'",
          "title": "To",
          "id": "maskEdgeTo",
          "slider": {
            "default": 100,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "visible": "maskType == 'linear'",
          "title": "Angle",
          "id": "maskLinearAngle",
          "number": {
            "default": 45,
            "subtitle": "in degrees"
          }
        },
        {
          "visible": "maskType == 'linear'",
          "title": "From",
          "id": "maskLinearFrom",
          "slider": {
            "default": 10,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "visible": "maskType == 'linear'",
          "title": "To",
          "id": "maskLinearTo",
          "slider": {
            "default": 90,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "visible": "maskType == 'radial'",
          "title": "Size",
          "id": "maskRadialSize",
          "select": {
            "default": "mask-radial-[100%_100%]",
            "items": [
              {
                "title": "Full",
                "value": "mask-radial-[100%_100%]"
              },
              {
                "title": "Closest Side",
                "value": "mask-radial-closest-side"
              },
              {
                "title": "Closest Corner",
                "value": "mask-radial-closest-corner"
              },
              {
                "title": "Farthest Side",
                "value": "mask-radial-farthest-side"
              },
              {
                "title": "Farthest Corner",
                "value": "mask-radial-farthest-corner"
              }
            ]
          }
        },
        {
          "visible": "maskType == 'radial'",
          "title": "Position",
          "id": "maskRadialPosition",
          "select": {
            "default": "mask-radial-at-center",
            "items": [
              {
                "title": "Top Left",
                "value": "mask-radial-at-top-left"
              },
              {
                "title": "Top",
                "value": "mask-radial-at-top"
              },
              {
                "title": "Top Right",
                "value": "mask-radial-at-top-right"
              },
              {
                "title": "Left",
                "value": "mask-radial-at-left"
              },
              {
                "title": "Center",
                "value": "mask-radial-at-center"
              },
              {
                "title": "Right",
                "value": "mask-radial-at-right"
              },
              {
                "title": "Bottom Left",
                "value": "mask-radial-at-bottom-left"
              },
              {
                "title": "Bottom",
                "value": "mask-radial-at-bottom"
              },
              {
                "title": "Bottom Right",
                "value": "mask-radial-at-bottom-right"
              }
            ]
          }
        },
        {
          "visible": "maskType == 'radial'",
          "title": "From",
          "id": "maskRadialFrom",
          "slider": {
            "default": 70,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "visible": "maskType == 'radial'",
          "title": "To",
          "id": "maskRadialTo",
          "slider": {
            "default": 100,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        }
      ]
    },
    {
      "title": "Layout",
      "icon": "square.split.bottomrightquarter",
      "properties": [
        {
          "globalControl": "Layout"
        }
      ]
    },
    {
      "title": "Sizing",
      "icon": "arrow.down.backward.and.arrow.up.forward.square",
      "properties": [
        {
          "globalControl": "Sizing"
        }
      ]
    },
    {
      "title": "Spacing",
      "icon": "squareshape.squareshape.dotted",
      "properties": [
        {
          "globalControl": "Spacing"
        }
      ]
    },
    {
      "title": "Transitions",
      "icon": "wand.and.stars.inverse",
      "properties": [
        {
          "globalControl": "Transitions"
        }
      ]
    }
  ]
}
