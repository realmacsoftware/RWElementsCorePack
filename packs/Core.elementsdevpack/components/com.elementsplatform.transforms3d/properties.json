          "responsive": false,
          "select": {
            "default": "self",
            "items": [
              {
                "title": "Self",
                "value": "self"
              },
              {
                "title": "Parent",
                "value": "parent"
              },
              {
                "title": "Container",
                "value": "container"
              },
              {
                "title": "Grid",
                "value": "grid"
              },
