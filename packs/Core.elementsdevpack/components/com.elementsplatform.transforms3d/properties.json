          "format": "scale-x-[{{value}}%]",
          "number": {
            "default": 100,
            "subtitle": "%"
          },
          "visible": "globalControlTypeTransforms == 'static' || (globalControlTypeTransforms == 'hover' && globalTransformsState == 'start')"
        },
        {
          "title": "Rotate",
