    {
      "title": "Overlay",
      "icon": "plus.rectangle",
      "properties": [
        {
          "title": "Color",
          "id": "overlayColor",
          "format": "bg-{{value}}/(--overlay-bg-opacity)",
          "themeColor": {
            "mode": "single",
            "default": {
              "name": "surface",
              "brightness": 50
            }
          }
        },
        {
          "title": "Opacity",
          "id": "overlayOpacity",
          "format": "[--overlay-bg-opacity:{{value}}%]",
          "slider": {
            "default": 20,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "title": "Blur",
          "id": "overlayBlur",
          "format": "backdrop-blur-[{{value}}px]",
          "slider": {
            "default": 3,
            "min": 0,
            "max": 10,
            "round": true,
            "snap": true,
            "units": "px"
          }
        }
      ]
