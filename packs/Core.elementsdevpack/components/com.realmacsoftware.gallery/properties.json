    {
      "title": "Navigation",
      "icon": "arrow.triangle.swap",
      "properties": [
        {
          "title": "General",
          "heading": {}
        },
        {
          "title": "Border Radius",
          "id": "navigationRadius",
          "themeBorderRadius": {
            "default": {
              "base": {
                "value": "full"
              }
            }
          }
        },
        {
          "title": "Padding",
          "id": "navigationPadding",
          "format": "p-{{value}}",
          "themeSpacing": {
            "mode": "single",
            "default": {
              "base": {
                "value": "2"
              }
            }
          }
        },
        {
          "title": "Size",
          "id": "navigationSize",
          "format": "size-[{{value}}px]",
          "slider": {
            "default": 24,
            "min": 0,
            "max": 48,
            "round": true,
            "snap": true,
            "units": "px"
          }
        },
        {
          "divider": {}
        },
        {
          "title": "State",
          "id": "navigationState",
          "segmented": {
            "default": "default",
            "items": [
              {
                "title": "Default",
                "value": "default"
              },
              {
                "title": "Hover",
                "value": "hover"
              }
            ]
          }
        },
        {
          "title": "Close Button",
          "heading": {}
        },
