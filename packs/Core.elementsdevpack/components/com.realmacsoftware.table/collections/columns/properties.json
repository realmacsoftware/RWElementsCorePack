{
  "groups": [
    {
      "title": "Column",
      "properties": [
        {
          "visible": "dataSource == 'manual'",
          "title": "Cell Mode",
          "property": "cellMode",
          "responsive": false,
          "segmented": {
            "default": "text",
            "items": [
              {
                "title": "Text",
                "value": "text"
              },
              {
                "title": "Dropzone",
                "value": "dropzone"
              }
            ]
          }
        },
        {
          "visible": "dataSource == 'manual'",
          "divider": {}
        },
        {
          "title": "Width",
          "property": "columnWidth",
          "format": "w-{{value}}",
          "themeSpacing": {
            "mode": "single",
            "default": {
              "base": {
                "custom": false,
                "value": "auto"
              }
            }
          }
        },
        {
          "title": "Alignment",
          "property": "columnAlignment",
          "segmented": {
            "default": "",
            "items": [
              {
                "title": "Default",
                "value": ""
              },
              {
                "icon": "text.alignleft",
                "value": "text-left"
              },
              {
                "icon": "text.aligncenter",
                "value": "text-center"
              },
              {
                "icon": "text.alignright",
                "value": "text-right"
              }
            ]
          }
        },
        {
          "divider": {}
        },
        {
          "title": "Sortable",
          "property": "columnSortable",
          "responsive": false,
          "switch": {
            "default": false
          }
        },
        {
          "title": "Hidden",
          "property": "columnHidden",
          "switch": {
            "default": false
          }
        }
      ]
    },
    {
      "title": "Advanced",
      "icon": "gearshape",
      "properties": [
        {
          "title": "Classes",
          "id": "cssClasses",
          "ai": {
            "name": "cssClasses",
            "description": "Space-separated CSS class names (no leading dots). Prefer Inspector settings when they already cover the same styling."
          },
          "textArea": {
            "default": ""
          }
        },
        {
          "title": "ID",
          "id": "globalID",
          "ai": {
            "name": "htmlId",
            "description": "HTML id (no leading #). Unique on the page. Registers an on-page anchor in the Link panel, a CSS/JS hook, and the Tailwind hover-group name."
          },
          "responsive": false,
          "text": {
            "default": ""
          }
        }
      ]
    }
  ]
}