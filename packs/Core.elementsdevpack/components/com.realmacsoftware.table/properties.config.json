{
  "groups": [
    {
      "title": "Settings",
      "icon": "gearshape",
      "properties": [
        {
          "title": "Data Source",
          "id": "dataSource",
          "responsive": false,
          "ai": {
            "name": "dataSource",
            "description": "Table data source: manual rows/columns, a CSV file resource, or a CSV/Google Sheets URL."
          },
          "select": {
            "default": "manual",
            "items": [
              {
                "title": "Manual",
                "value": "manual"
              },
              {
                "title": "CSV File",
                "value": "csvFile"
              },
              {
                "title": "CSV URL",
                "value": "csvUrl"
              }
            ]
          }
        },
        {
          "title": "CSV File",
          "id": "csvFile",
          "visible": "dataSource == 'csvFile'",
          "ai": {
            "name": "csvFile",
            "description": "CSV file resource ID bound to the table."
          },
          "resource": {
            "accepts": ".csv"
          }
        },
        {
          "title": "CSV URL",
          "id": "csvUrl",
          "visible": "dataSource == 'csvUrl'",
          "responsive": false,
          "ai": {
            "name": "csvUrl",
            "description": "URL returning CSV data (or a Google Sheets link)."
          },
          "text": {
            "default": "",
            "subtitle": "Any URL that returns CSV data, or a Google Sheets link"
          }
        },
        {
          "visible": "dataSource != 'manual'",
          "divider": {}
        },
        {
          "visible": "dataSource != 'manual'",
          "title": "First Row is Header",
          "heading": {}
        },
        {
          "title": "Enable",
          "id": "csvFirstRowIsHeader",
          "visible": "dataSource != 'manual'",
          "responsive": false,
          "ai": {
            "name": "csvFirstRowIsHeader",
            "description": "Treat the first row of CSV data as the header row."
          },
          "switch": {
            "default": true
          }
        },
        {
          "divider": {}
        },
        {
          "title": "Columns",
          "id": "columns",
          "collection": {
            "identifier": "com.realmacsoftware.table.collections.columns"
          }
        },
        {
          "visible": "dataSource != 'manual'",
          "title": "Each column item controls the matching CSV column by position (1st item \u2192 1st column).",
          "description": {}
        },
        {
          "visible": "dataSource == 'manual'",
          "divider": {}
        },
        {
          "visible": "dataSource == 'manual'",
          "title": "Table Settings",
          "heading": {}
        },
        {
          "visible": "dataSource == 'manual'",
          "title": "Rows",
          "id": "rowCount",
          "responsive": false,
          "ai": {
            "name": "rowCount",
            "description": "Number of manual body rows to render."
          },
          "number": {
            "default": 3
          }
        }
      ]
    },
    {
      "title": "Interactive",
      "icon": "hand.tap",
      "properties": [
        {
          "title": "Sorting",
          "heading": {}
        },
        {
          "visible": "dataSource == 'manual'",
          "title": "Enable sorting per column in the Columns collection.",
          "description": {}
        },
        {
          "visible": "dataSource != 'manual'",
          "title": "Enable sorting per column in the Columns collection.",
          "description": {}
        },
        {
          "divider": {}
        },
        {
          "title": "Search",
          "heading": {}
        },
        {
          "title": "Enable",
          "id": "showSearch",
          "responsive": false,
          "ai": {
            "name": "showSearch",
            "description": "Show the search bar above the table."
          },
          "switch": {
            "default": false
          }
        },
        {
          "enable": "showSearch == true",
          "title": "Placeholder",
          "id": "searchPlaceholder",
          "responsive": false,
          "ai": {
            "name": "searchPlaceholder",
            "description": "Placeholder text shown in the search input."
          },
          "text": {
            "default": "Search..."
          }
        },
        {
          "divider": {}
        },
        {
          "title": "Pagination",
          "heading": {}
        },
        {
          "title": "Enable",
          "id": "showPagination",
          "responsive": false,
          "ai": {
            "name": "showPagination",
            "description": "Show pagination controls below the table."
          },
          "switch": {
            "default": false
          }
        },
        {
          "enable": "showPagination == true",
          "title": "Rows Per Page",
          "id": "rowsPerPage",
          "responsive": false,
          "ai": {
            "name": "rowsPerPage",
            "description": "Number of rows shown per page when pagination is enabled."
          },
          "number": {
            "default": 10,
            "min": 1,
            "max": 100
          }
        }
      ]
    },
    {
