{
  "groups": [
    {
      "title": "Media",
      "icon": "photo",
      "properties": [
        {
          "title": "Resource",
          "id": "media",
          "resource": {}
        },
        {
          "title": "Alt Text",
          "id": "mediaAlt",
          "responsive": false,
          "text": {
            "default": ""
          }
        },
        {
          "divider": {}
        },
        {
          "title": "Float",
          "id": "mediaFloat",
          "format": "float-{{value}}",
          "segmented": {
            "default": "left",
            "items": [
              {
                "title": "None",
                "value": "none"
              },
              {
                "title": "Left",
                "value": "left"
              },
              {
                "title": "Right",
                "value": "right"
              }
            ]
          }
        },
        {
          "title": "Width",
          "id": "mediaWidth",
          "format": "w-[{{value}}%]",
          "slider": {
            "default": 40,
            "min": 10,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "title": "Margin",
          "id": "shapeMargin",
          "format": "[shape-margin:{{value}}px]",
          "slider": {
            "default": 16,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "px"
          }
        },
        {
          "information": {},
          "title": "Margin controls the gap between the shape and the wrapping text. Use Spacing for regular margins around the media."
        }
      ]
    },
    {
      "title": "Shape",
      "icon": "hexagon",
      "properties": [
        {
          "title": "Source",
          "id": "shapeSource",
          "responsive": false,
          "select": {
            "default": "auto",
            "items": [
              {
                "title": "Auto (From Image)",
                "value": "auto"
              },
              {
                "title": "Circle",
                "value": "circle"
              },
              {
                "title": "Ellipse",
                "value": "ellipse"
              },
              {
                "title": "Preset",
                "value": "preset"
              },
              {
                "title": "Custom",
                "value": "custom"
              },
              {
                "title": "None",
                "value": "none"
              }
            ]
          }
        },
        {
          "visible": "shapeSource == 'auto'",
          "title": "Threshold",
          "id": "shapeImageThreshold",
          "responsive": false,
          "slider": {
            "default": 50,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "visible": "shapeSource == 'auto'",
          "information": {},
          "title": "Auto uses the image's transparency (PNG, WebP, SVG). It has no effect on videos, which wrap as a rectangle."
        },
        {
          "visible": "shapeSource == 'preset'",
          "title": "Shape",
          "id": "shapePreset",
          "select": {
            "default": "triangle",
            "items": [
              {
                "title": "Triangle",
                "value": "triangle"
              },
              {
                "title": "Triangle Down",
                "value": "triangle-down"
              },
              {
                "title": "Trapezoid",
                "value": "trapezoid"
              },
              {
                "title": "Parallelogram",
                "value": "parallelogram"
              },
              {
                "title": "Rhombus",
                "value": "rhombus"
              },
              {
                "title": "Pentagon",
                "value": "pentagon"
              },
              {
                "title": "Hexagon",
                "value": "hexagon"
              },
              {
                "title": "Octagon",
                "value": "octagon"
              },
              {
                "title": "Star",
                "value": "star"
              },
              {
                "title": "Arrow Left",
                "value": "arrow-left"
              },
              {
                "title": "Arrow Right",
                "value": "arrow-right"
              },
              {
                "title": "Chevron",
                "value": "chevron"
              },
              {
                "title": "Message",
                "value": "message"
              },
              {
                "title": "Frame",
                "value": "frame"
              }
            ]
          }
        },
        {
          "visible": "shapeSource == 'circle'",
          "title": "Radius",
          "id": "shapeCircleRadius",
          "slider": {
            "default": 50,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "visible": "shapeSource == 'circle'",
          "title": "Position",
          "id": "shapeCirclePosition",
          "select": {
            "default": "center",
            "items": [
              {
                "title": "Top Left",
                "value": "top left"
              },
              {
                "title": "Top",
                "value": "top"
              },
              {
                "title": "Top Right",
                "value": "top right"
              },
              {
                "title": "Left",
                "value": "left"
              },
              {
                "title": "Center",
                "value": "center"
              },
              {
                "title": "Right",
                "value": "right"
              },
              {
                "title": "Bottom Left",
                "value": "bottom left"
              },
              {
                "title": "Bottom",
                "value": "bottom"
              },
              {
                "title": "Bottom Right",
                "value": "bottom right"
              }
            ]
          }
        },
        {
          "visible": "shapeSource == 'ellipse'",
          "title": "Radius X",
          "id": "shapeEllipseRadiusX",
          "slider": {
            "default": 50,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "visible": "shapeSource == 'ellipse'",
          "title": "Radius Y",
          "id": "shapeEllipseRadiusY",
          "slider": {
            "default": 50,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "visible": "shapeSource == 'ellipse'",
          "title": "Position",
          "id": "shapeEllipsePosition",
          "select": {
            "default": "center",
            "items": [
              {
                "title": "Top Left",
                "value": "top left"
              },
              {
                "title": "Top",
                "value": "top"
              },
              {
                "title": "Top Right",
                "value": "top right"
              },
              {
                "title": "Left",
                "value": "left"
              },
              {
                "title": "Center",
                "value": "center"
              },
              {
                "title": "Right",
                "value": "right"
              },
              {
                "title": "Bottom Left",
                "value": "bottom left"
              },
              {
                "title": "Bottom",
                "value": "bottom"
              },
              {
                "title": "Bottom Right",
                "value": "bottom right"
              }
            ]
          }
        },
        {
          "visible": "shapeSource == 'custom'",
          "title": "Shape",
          "id": "shapeCustom",
          "text": {
            "default": "polygon(50% 0%,100% 100%,0% 100%)",
            "subtitle": "Any CSS basic shape such as polygon(...), circle(...), ellipse(...) or inset(...). Spaces are converted automatically."
          }
        },
        {
          "visible": "shapeSource != 'auto' && shapeSource != 'none'",
          "title": "Clip Media to Shape",
          "id": "clipMedia",
          "responsive": false,
          "switch": {
            "default": true
          }
        }
      ]
    },
    {
      "title": "Layout",
      "icon": "square.split.bottomrightquarter",
      "properties": [
        {
          "globalControl": "Layout"
        }
      ]
    },
    {
      "title": "Sizing",
      "icon": "arrow.down.backward.and.arrow.up.forward.square",
      "properties": [
        {
          "globalControl": "Sizing"
        }
      ]
    },
    {
      "title": "Spacing",
      "icon": "squareshape.squareshape.dotted",
      "properties": [
        {
          "globalControl": "Spacing"
        }
      ]
    },
    {
      "title": "Transitions",
      "icon": "wand.and.stars.inverse",
      "properties": [
        {
          "globalControl": "Transitions"
        }
      ]
    }
  ]
}
