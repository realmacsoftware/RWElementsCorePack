{
  "groups": [
    {
      "title": "Media",
      "icon": "photo",
      "properties": [
        {
          "title": "Resource",
          "id": "media",
          "resource": {}
        },
        {
          "title": "Alt Text",
          "id": "mediaAlt",
          "responsive": false,
          "text": {
            "default": ""
          }
        },
        {
          "divider": {}
        },
        {
          "title": "Float",
          "id": "mediaFloat",
          "format": "float-{{value}}",
          "segmented": {
            "default": "left",
            "items": [
              {
                "title": "None",
                "value": "none"
              },
              {
                "title": "Left",
                "value": "left"
              },
              {
                "title": "Right",
                "value": "right"
              }
            ]
          }
        },
        {
          "title": "Width",
          "id": "mediaWidth",
          "format": "w-[{{value}}%]",
          "slider": {
            "default": 40,
            "min": 10,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "title": "Margin",
          "id": "shapeMargin",
          "format": "[shape-margin:{{value}}]",
          "themeSpacing": {
            "mode": "single",
            "default": {
              "base": {
                "value": "4"
              }
            }
          }
        },
        {
          "title": "Threshold",
          "id": "shapeImageThreshold",
          "responsive": false,
          "slider": {
            "default": 50,
            "min": 0,
            "max": 100,
            "round": true,
            "snap": true,
            "units": "%"
          }
        },
        {
          "information": {},
          "title": "How opaque a pixel must be before text stops wrapping. Lower keeps text further from soft edges."
        }
      ]
    },
    {
      "title": "Layout",
      "icon": "square.split.bottomrightquarter",
      "properties": [
        {
          "globalControl": "Layout"
        }
      ]
    },
    {
      "title": "Sizing",
      "icon": "arrow.down.backward.and.arrow.up.forward.square",
      "properties": [
        {
          "globalControl": "Sizing"
        }
      ]
    },
    {
      "title": "Spacing",
      "icon": "squareshape.squareshape.dotted",
      "properties": [
        {
          "globalControl": "Spacing"
        }
      ]
    },
    {
      "title": "Transitions",
      "icon": "wand.and.stars.inverse",
      "properties": [
        {
          "globalControl": "Transitions"
        }
      ]
    }
  ]
}
