{
  "groups": [
    {
      "title": "Settings",
      "icon": "gearshape",
      "properties": [
        {
          "title": "Panel",
          "heading": {}
        },
        {
          "title": "Show",
          "id": "panelShowInEdit",
          "responsive": false,
          "switch": {
            "default": false
          }
        },
        {
          "title": "Vertical",
          "id": "panelPositionVertical",
          "responsive": false,
          "select": {
            "default": "top-full",
            "items": [
              {
                "title": "Bottom",
                "value": "top-full"
              },
              {
                "title": "Top",
                "value": "bottom-full"
              }
            ]
          }
        },
        {
          "title": "Horizontal",
          "id": "panelPositionHorizontal",
          "responsive": false,
          "select": {
            "default": "left-1/2 -translate-x-1/2",
            "items": [
              {
                "title": "Left",
                "value": "left-0"
              },
              {
                "title": "Center",
                "value": "left-1/2 -translate-x-1/2"
              },
              {
                "title": "Right",
                "value": "right-0"
              }
            ]
          }
        }
      ]
    },
    {
      "title": "Transition",
      "icon": "wand.and.stars.inverse",
      "properties": [
        {
          "title": "Style",
          "id": "dropdownTransitionStyle",
          "select": {
            "default": "fade",
            "items": [
              {
                "title": "None",
                "value": "none"
              },
              {
                "title": "Fade",
                "value": "fade"
              },
              {
                "title": "Zoom",
                "value": "zoom"
              },
              {
                "title": "Slide Left",
                "value": "slideLeftShort"
              },
              {
                "title": "Slide Right",
                "value": "slideRightShort"
              },
              {
                "title": "Slide Up",
                "value": "slideUpShort"
              },
              {
                "title": "Slide Down",
                "value": "slideDownShort"
              }
            ]
          }
        },
        {
          "title": "Duration",
          "id": "dropdownTransitionDuration",
          "format": "duration-[{{value}}ms]",
          "number": {
            "default": 300
          }
        }
      ]
    }
  ]
}

