              {
                "icon": "photo",
                "value": "image"
              },
              {
                "icon": "swatchpalette",
                "value": "gradient"
              }
            ]
          }
        },
        {
          "visible": "globalControlTypeBg == 'static' && globalBgType == 'color' || (globalControlTypeBg == 'hover' && globalBgState == 'start' && globalBgType == 'color')",
          "title": "Color",
          "id": "globalBgColor",
