{
  "groups": [
    {
      "title": "Spacing",
      "icon": "squareshape.squareshape.dotted",
      "properties": [
        {
          "title": "Margin & Padding",
          "heading": {}
        },
        {
          "title": "Enable",
          "id": "globalSpacingEnabled",
          "switch": {
            "default": false
          }
        },
        {
          "title": "Margin",
          "id": "globalMargin",
          "themeSpacing": {
            "mode": "margin",
            "default": {
              "base": {
                "top": "0",
                "right": "0",
                "bottom": "0",
                "left": "0"
              }
            }
          },
          "visible": "globalSpacingEnabled == true"
        },
        {
          "title": "Padding",
          "id": "globalPadding",
          "themeSpacing": {
            "mode": "padding",
            "default": {
              "base": {
                "top": "0",
                "right": "0",
                "bottom": "0",
                "left": "0"
              }
            }
          },
          "visible": "globalSpacingEnabled == true"
        }
      ]
    },
    {
      "title": "Sizing",
      "icon": "square.resize",
      "properties": [
        {
          "title": "Width",
          "id": "width",
          "format": "w-{{value}}",
          "themeSpacing": {
            "mode": "single",
            "default": {
              "value": "auto"
            }
          }
        },
        {
          "title": "Height",
          "id": "height",
          "format": "h-{{value}}",
          "themeSpacing": {
            "mode": "single",
            "default": {
              "value": "0.5"
            }
          }
        }
      ]
    },
    {
      "title": "Background",
