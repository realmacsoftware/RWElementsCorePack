        {
          "title": "Enable",
          "id": "enableAngle",
          "responsive": false,
          "switch": {
            "default": false
          }
        },
        {
          "visible": "enableAngle == true",
          "divider": {}
        },
        {
          "visible": "enableAngle == true",
          "enable": "enableAngle == true",
          "title": "Mode",
          "id": "angleMode",
          "responsive": false,
          "segmented": {
            "default": "vertical",
            "items": [
              {
                "icon": "arrow.left.and.right",
                "value": "vertical",
                "title": "Vertical"
              },
              {
                "icon": "arrow.up.and.down",
                "value": "horizontal",
                "title": "Horizontal"
              }
            ]
          }
        },
        {
          "visible": "enableAngle == true && angleMode == 'vertical'",
          "enable": "enableAngle == true && angleMode == 'vertical'",
          "title": "Top",
          "heading": {}
        },
        {
          "visible": "enableAngle == true && angleMode == 'vertical'",
          "enable": "enableAngle == true && angleMode == 'vertical'",
          "title": "Left",
          "id": "angleTopLeft",
          "responsive": false,
