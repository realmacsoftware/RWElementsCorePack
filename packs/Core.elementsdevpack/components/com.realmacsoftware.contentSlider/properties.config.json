{
    "groups": [
        {
            "title": "Slides",
            "icon": "rectangle.stack",
            "properties": [
                {
                    "title": "Number of Slides",
                    "heading": {}
                },
                {
                    "information": {},
                    "title": "Create slides by adding items to the Slides collection."
                },
                {
                    "title": "Slides",
                    "property": "slides",
                    "collection": {
                        "identifier": "com.realmacsoftware.contentSlider.collections.slides"
                    }
                },
                {
                    "divider": {}
                },
                {
                    "visible": "layout != 'cardRow'",
                    "title": "Editor Preview",
                    "heading": {}
                },
                {
                    "visible": "layout != 'cardRow'",
                    "information": {},
                    "title": "Preview the slide that will be shown in the editor."
                },
                {
                    "visible": "layout != 'cardRow'",
                    "title": "Active Slide",
                    "id": "editorActiveSlide",
                    "responsive": false,
                    "number": {
                        "default": 1
                    }
                }
            ]
        },
        {
            "title": "Playback",
            "icon": "play.rectangle",
            "properties": [
                {
                    "title": "Layout",
                    "heading": {}
                },
                {
                    "title": "Layout",
                    "id": "layout",
                    "responsive": false,
                    "segmented": {
                        "default": "single",
                        "items": [
                            {
                                "title": "Single",
                                "value": "single"
                            },
                            {
                                "title": "Card row",
                                "value": "cardRow"
                            }
                        ]
                    }
                },
                {
                    "visible": "layout == 'cardRow'",
                    "information": {},
                    "title": "Show several cards at once with a peek of the next card. Use the breakpoint switcher on Visible Slides to set how many show on mobile, tablet, desktop, and large displays."
                },
                {
                    "enable": "layout == 'cardRow'",
                    "title": "Visible Slides",
                    "id": "visibleSlides",
                    "responsive": true,
                    "slider": {
                        "default": "3",
                        "items": [
                            { "title": "1", "value": "1" },
                            { "title": "2", "value": "2" },
                            { "title": "3", "value": "3" },
                            { "title": "4", "value": "4" },
                            { "title": "5", "value": "5" },
                            { "title": "6", "value": "6" }
                        ]
                    }
                },
                {
                    "enable": "layout == 'cardRow'",
                    "title": "Peek Next Card",
                    "id": "peekNext",
                    "responsive": false,
                    "switch": {
                        "default": true
                    }
                },
                {
                    "enable": "layout == 'cardRow'",
                    "title": "Gap",
                    "id": "slideGap",
                    "responsive": false,
                    "number": {
                        "default": 16,
                        "subtitle": "pixels between cards"
                    }
                },
                {
                    "enable": "layout == 'cardRow'",
                    "title": "Scroll",
                    "id": "scrollMode",
                    "responsive": false,
                    "segmented": {
                        "default": "free",
                        "items": [
                            {
                                "title": "Free",
                                "value": "free"
                            },
                            {
                                "title": "Snap",
                                "value": "snap"
                            }
                        ]
                    }
                },
                {
                    "divider": {}
                },
                {
                    "title": "Transition",
                    "heading": {}
                },
                {
                    "enable": "layout != 'cardRow'",
                    "title": "Effect",
                    "id": "transitionEffect",
                    "responsive": false,
                    "segmented": {
                        "default": "slide",
                        "items": [
                            {
                                "title": "Slide",
                                "value": "slide"
                            },
                            {
                                "title": "Fade",
                                "value": "fade"
                            }
                        ]
                    }
                },
                {
                    "divider": {}
                },
                {
                    "title": "Auto Play",
                    "heading": {}
                },
                {
                    "title": "Enabled",
                    "id": "autoPlay",
                    "responsive": false,
                    "switch": {
                        "default": true
                    }
                },
                {
                    "enable": "autoPlay == true",
                    "title": "Interval",
                    "id": "autoPlayInterval",
                    "responsive": false,
                    "select": {
                        "default": "5000",
                        "items": [
                            {
                                "title": "3 seconds",
                                "value": "3000"
                            },
                            {
                                "title": "5 seconds",
                                "value": "5000"
                            },
                            {
                                "title": "7 seconds",
                                "value": "7000"
                            },
                            {
                                "title": "10 seconds",
                                "value": "10000"
                            },
                            {
                                "title": "15 seconds",
                                "value": "15000"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "title": "Navigation",
            "icon": "arrow.left.arrow.right",
            "properties": [
                {
                    "title": "Arrows",
                    "heading": {}
                },
                {
                    "title": "Show Arrows",
                    "id": "showArrows",
                    "responsive": false,
                    "switch": {
                        "default": true
                    }
                },
                {
                    "enable": "showArrows == true",
                    "title": "Size",
                    "id": "arrowSize",
                    "format": "size-{{value}}",
                    "themeSpacing": {
                        "mode": "single",
                        "default": {
                            "base": {
                                "value": "10"
                            }
                        }
                    }
                },
                {
                    "enable": "showArrows == true",
                    "title": "Radius",
                    "id": "arrowBorderRadius",
                    "themeBorderRadius": {
                        "default": {
                            "base": {
                                "value": "full"
                            }
                        }
                    }
                },
                {
                    "enable": "showArrows == true",
                    "title": "State",
                    "id": "arrowState",
                    "segmented": {
                        "default": "normal",
                        "items": [
                            {
                                "title": "Normal",
                                "value": "normal"
                            },
                            {
                                "title": "Hover",
                                "value": "hover"
                            }
                        ]
                    }
                },
                {
                    "enable": "showArrows == true",
                    "visible": "arrowState == 'normal'",
                    "title": "Background",
                    "id": "arrowBgColor",
                    "format": "bg-{{value}}",
                    "themeColor": {
                        "default": {
                            "name": "surface",
                            "brightness": 100
                        }
                    }
                },
                {
                    "enable": "showArrows == true",
                    "visible": "arrowState == 'normal'",
                    "title": "Color",
                    "id": "arrowColor",
                    "format": "text-{{value}}",
                    "themeColor": {
                        "default": {
                            "name": "text",
                            "brightness": 50
                        }
                    }
                },
                {
                    "enable": "showArrows == true",
                    "visible": "arrowState == 'hover'",
                    "title": "Background",
                    "id": "arrowBgColorHover",
                    "format": "hover:bg-{{value}}",
                    "themeColor": {
                        "default": {
                            "name": "surface",
                            "brightness": 200
                        }
                    }
                },
                {
                    "enable": "showArrows == true",
                    "visible": "arrowState == 'hover'",
                    "title": "Color",
                    "id": "arrowColorHover",
                    "format": "hover:text-{{value}}",
                    "themeColor": {
                        "default": {
                            "name": "text",
                            "brightness": 50
                        }
                    }
                },
                {
                    "divider": {}
                },
                {
                    "title": "Dots",
                    "heading": {}
                },
                {
                    "title": "Show Dots",
                    "id": "showDots",
                    "responsive": false,
                    "switch": {
                        "default": true
                    }
                },
                {
                    "enable": "showDots == true",
                    "title": "Size",
                    "id": "dotSize",
                    "format": "size-{{value}}",
                    "themeSpacing": {
                        "mode": "single",
                        "default": {
                            "base": {
                                "value": "3"
                            }
                        }
                    }
                },
                {
                    "enable": "showDots == true",
                    "title": "Spacing",
                    "id": "dotGap",
                    "format": "gap-{{value}}",
                    "themeSpacing": {
                        "mode": "single",
                        "default": {
                            "base": {
                                "value": "2"
                            }
                        }
                    }
                },
                {
                    "enable": "showDots == true",
                    "title": "State",
                    "id": "dotState",
                    "segmented": {
                        "default": "normal",
                        "items": [
                            {
                                "title": "Normal",
                                "value": "normal"
                            },
                            {
                                "title": "Active",
                                "value": "active"
                            }
                        ]
                    }
                },
                {
                    "enable": "showDots == true",
                    "visible": "dotState == 'normal'",
                    "title": "Color",
                    "id": "dotColor",
                    "format": "bg-{{value}}",
                    "themeColor": {
                        "default": {
                            "name": "surface",
                            "brightness": 300
                        }
                    }
                },
                {
                    "enable": "showDots == true",
                    "visible": "dotState == 'active'",
                    "title": "Active Color",
                    "id": "dotColorActive",
                    "format": "bg-{{value}}",
                    "themeColor": {
                        "default": {
                            "name": "brand",
                            "brightness": 500
                        }
                    }
                }
            ]
        },
        {
            "title": "Sizing",
            "icon": "arrow.down.backward.and.arrow.up.forward.square",
            "properties": [
                {
                    "globalControl": "Sizing"
                }
            ]
        },
        {
            "title": "Spacing",
            "icon": "squareshape.squareshape.dotted",
            "properties": [
                {
                    "globalControl": "Spacing"
                }
            ]
        },
        {
            "title": "Background",
            "icon": "paintbrush.fill",
            "properties": [
                {
                    "globalControl": "BackgroundTransparent"
                }
            ]
        },
        {
            "title": "Borders",
            "icon": "square.dashed",
            "properties": [
                {
                    "globalControl": "Borders"
                }
            ]
        }
    ]
}
