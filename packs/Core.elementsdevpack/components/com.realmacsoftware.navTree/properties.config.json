{
    "groups": [
        {
            "title": "General",
            "icon": "gearshape",
            "properties": [
                {
                    "title": "Preview Sub Menus",
                    "heading": {}
                },
                {
                    "title": "Enable",
                    "id": "previewSubMenus",
                    "responsive": false,
                    "switch": {
                        "default": false
                    }
                },
                {
                    "divider": {}
                },
                {
                    "title": "Pages",
                    "heading": {}
                },
                {
                    "title": "Use",
                    "id": "wantedPages",
                    "responsive": false,
                    "select": {
                        "default": "all",
                        "items": [
                            { "value": "all", "title": "All" },
                            { "value": "active", "title": "Active Page" },
                            { "value": "manual", "title": "Selected Page" }
                        ]
                    }
                },
                {
                    "visible": "wantedPages == 'manual'",
                    "title": "Page",
                    "id": "wantedPagesPageLink",
                    "link": {}
                },
                {
                    "divider": {}
                },
                {
                    "title": "Levels",
                    "heading": {}
                },
                {
                    "title": "Depth",
                    "id": "maxLevelsDepth",
                    "responsive": false,
                    "segmented": {
                        "default": "auto",
                        "items": [
                            { "value": "auto", "title": "Auto" },
                            { "value": "manual", "title": "Manual" }
                        ]
                    }
                },
                {
                    "visible": "maxLevelsDepth == 'manual'",
                    "title": "Show",
                    "id": "maxLevels",
                    "responsive": false,
                    "number": {
                        "default": 1,
                        "min": 1,
                        "max": 10
                    }
                },
                {
                    "divider": {}
                },
                {
                    "title": "Open & Close",
                    "heading": {}
                },
                {
                    "title": "Duration",
                    "id": "collapseDuration",
                    "format": "{{value}}ms",
                    "responsive": false,
                    "number": {
                        "default": 200,
                        "subtitle": "in milliseconds"
                    }
                }
            ]
        },
        {
            "title": "SVG Icon",
            "icon": "chevron.right.square",
            "properties": [
                {
                    "title": "Icon",
                    "id": "icon",
                    "resource": {}
                },
                {
                    "title": "Size",
                    "id": "iconSize",
                    "format": "[&>svg]:size-{{value}}",
                    "themeSpacing": {
                        "mode": "single",
                        "default": {
                            "base": {
                                "value": "4"
                            }
                        }
                    }
                },
                {
                    "divider": {}
                },
                {
                    "title": "Placement",
                    "id": "iconPlacement",
                    "segmented": {
                        "default": "order-last ms-auto",
                        "items": [
                            {
                                "title": "Start",
                                "value": "order-first"
                            },
                            {
                                "title": "End",
                                "value": "order-last ms-auto"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "title": "Top Level Pages",
            "icon": "1.circle.fill",
            "properties": [
                {
                    "title": "Page Icon",
                    "heading": {}
                },
                {
                    "title": "Display",
                    "id": "pageIconDisplay",
                    "responsive": false,
                    "switch": {
                        "default": false
                    }
                },
                {
                    "visible": "pageIconDisplay == 'true'",
                    "title": "Size",
                    "id": "pageIconSize",
                    "format": "[&>svg]:size-{{value}}",
                    "themeSpacing": {
                        "mode": "single",
                        "default": {
                            "base": {
                                "value": "5"
                            }
                        }
                    }
                },
                {
                    "visible": "pageIconDisplay == 'true'",
                    "title": "Spacing",
                    "id": "pageIconSpacing",
                    "format": "me-{{value}}",
                    "themeSpacing": {
                        "mode": "single",
                        "default": {
                            "base": {
                                "value": "2"
                            }
                        }
                    }
                },
                {
                    "divider": {}
                },
                {
                    "title": "Layout",
                    "heading": {}
                },
                {
                    "title": "Padding",
                    "id": "itemPadding",
                    "themeSpacing": {
                        "mode": "padding",
                        "default": {
                            "left": "2.5",
                            "right": "2.5",
                            "top": "2.5",
                            "bottom": "2.5",
                            "linkVertical": true,
                            "linkHorizontal": true
                        }
                    }
                },
                {
                    "title": "Gap",
                    "id": "topLevelGap",
                    "format": "gap-{{value}}",
                    "themeSpacing": {
                        "mode": "single",
                        "default": {
                            "base": {
                                "value": "2"
                            }
                        }
                    }
                },
                {
                    "divider": {}
                },
                {
                    "title": "Font Styles",
                    "heading": {}
                },
                {
                    "title": "Font",
                    "id": "topLevelFont",
                    "themeFont": {
                        "default": {
                            "base": {
                                "name": "body"
                            }
                        }
                    }
                },
                {
                    "title": "Size",
                    "id": "topLevelSize",
                    "themeTextStyle": {
                        "default": {
                            "base": {
                                "name": "base"
                            }
                        }
                    }
                },
                {
                    "title": "Weight",
                    "id": "topLevelFontWeight",
                    "format": "font-[{{value}}]",
                    "slider": {
                        "use": "FontWeight"
                    }
                },
                {
                    "title": "Letter Spacing",
                    "id": "topLevelLetterSpacing",
                    "format": "tracking-{{value}}",
                    "slider": {
                        "use": "LetterSpacing"
                    }
                },
                {
                    "title": "Line Height",
                    "id": "topLevelLineHeight",
                    "format": "leading-{{value}}",
                    "slider": {
                        "default": "normal",
                        "use": "LineHeight"
                    }
                },
                {
                    "divider": {}
                },
                {
                    "title": "Border Styles",
                    "heading": {}
                },
                {
                    "title": "Radius",
                    "id": "topLevelBorderRadius",
                    "themeBorderRadius": {
                        "default": {
                            "base": {
                                "value": "0"
                            }
                        }
                    }
                },
                {
                    "divider": {}
                },
                {
                    "title": "Color Styles",
                    "heading": {}
                },
                {
                    "title": "State",
                    "id": "topLevelState",
                    "segmented": {
                        "default": "normal",
                        "items": [
                            { "value": "normal", "title": "Normal" },
                            { "value": "hover", "title": "Hover" }
                        ]
                    }
                },
                {
                    "visible": "topLevelState == 'normal'",
                    "title": "Text",
                    "id": "topLevelTextColor",
                    "format": "text-{{value}}",
                    "themeColor": {
                        "default": {
                            "name": "text",
                            "brightness": 50
                        }
                    }
                },
                {
                    "visible": "topLevelState == 'normal'",
                    "title": "Background",
                    "id": "topLevelBgColor",
                    "format": "bg-{{value}}/(--top-level-bg-opacity)",
                    "themeColor": {
                        "default": {
                            "name": "surface",
                            "brightness": 50
                        }
                    }
                },
                {
                    "visible": "topLevelState == 'normal'",
                    "title": "Opacity",
                    "id": "topLevelBgColorOpacity",
                    "format": "[--top-level-bg-opacity:{{value}}%]",
                    "slider": {
                        "use": "Slider",
                        "default": 100,
                        "units": "%"
                    }
                },
                {
                    "visible": "topLevelState == 'hover'",
                    "title": "Text",
                    "id": "topLevelTextColorHover",
                    "format": "hover:text-{{value}} aria-[current=page]:text-{{value}}",
                    "themeColor": {
                        "default": {
                            "name": "brand",
                            "brightness": 600
                        }
                    }
                },
                {
                    "visible": "topLevelState == 'hover'",
                    "title": "Background",
                    "id": "topLevelBgColorHover",
                    "format": "hover:bg-{{value}}/(--top-level-bg-opacity) aria-[current=page]:bg-{{value}}/(--top-level-bg-opacity)",
                    "themeColor": {
                        "default": {
                            "name": "surface",
                            "brightness": 100
                        }
                    }
                },
                {
                    "visible": "topLevelState == 'hover'",
                    "title": "Opacity",
                    "id": "topLevelBgColorOpacityHover",
                    "format": "hover:[--top-level-bg-opacity:{{value}}%] aria-[current=page]:[--top-level-bg-opacity:{{value}}%]",
                    "slider": {
                        "use": "Slider",
                        "default": 100,
                        "units": "%"
                    }
                }
            ]
        },
